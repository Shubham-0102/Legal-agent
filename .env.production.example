# Public domain name; DNS must point here before starting Caddy.
APP_DOMAIN=legal.example.com

# Generate a long random hexadecimal value: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_random_hex
JWT_SECRET=replace_with_a_different_random_hex
DATABASE_URL=postgresql+asyncpg://legal:replace_with_the_same_random_hex@db:5432/legal

# Choose Gemini or OpenAI and set the matching API key.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
CHAT_MODEL=gemini-3.5-flash
EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
CORS_ORIGINS=https://legal.example.com
MAX_UPLOAD_MB=25
UPLOAD_DIR=/data/uploads
